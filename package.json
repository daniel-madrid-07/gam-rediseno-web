{
  "name": "gam-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio de alquiler, venta y mantenimiento de maquinaria industrial de GAM",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:fast": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "auditar": "node scripts/auditar.mjs",
    "verify": "npm run lint && npm run check && npm run test && npm run test:e2e",
    "deploy": "cross-env DESPLIEGUE=github astro build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/svelte": "^7.2.0",
    "@nanostores/persistent": "^1.1.0",
    "astro": "^5.16.0",
    "nanostores": "^1.0.1",
    "svelte": "^5.42.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^17.11.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0"
  }
}

{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro", "**/*.svelte"],
  "exclude": ["dist", "node_modules", "_legacy", "publicacion"],
  "compilerOptions": {
    "strictNullChecks": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@datos/*": ["src/datos/*"],
      "@lib/*": ["src/lib/*"],
      "@componentes/*": ["src/componentes/*"],
      "@islas/*": ["src/islas/*"],
      "@tipos": ["src/tipos/index.ts"]
    }
  }
}

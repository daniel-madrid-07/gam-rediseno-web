---
import { SITIO } from "@/config/sitio";

/**
 * Metadatos del documento.
 *
 * El `canonical` apunta siempre al sitio oficial de producción, no al dominio
 * donde esté desplegada esta versión: así una vista previa nunca compite en
 * buscadores con gamrentals.com ni se lleva sus posiciones.
 */
/** Recurso que debe empezar a descargarse antes de que el CSS lo descubra. */
export interface Precarga {
  href: string;
  como: "image" | "font" | "style" | "script";
  /** Sube la prioridad de la descarga. Imprescindible en la imagen del LCP. */
  prioritaria?: boolean;
  /** Restringe la precarga a un ancho concreto, para `<picture>`. */
  media?: string;
  srcset?: string;
  sizes?: string;
  tipo?: string;
}

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta canónica sin dominio, p. ej. "/maquinaria/plat-tijera". */
  ruta?: string;
  imagen?: string;
  tipo?: "website" | "article" | "product";
  precargas?: Precarga[];
}

const {
  titulo,
  descripcion,
  ruta = "/",
  tipo = "website",
  precargas = [],
  imagen = "https://gamrentals.com/media/media-bd/imagenes/cabecera-alquiler-1920x550-1595927378.png",
} = Astro.props;

const canonica = new URL(ruta, "https://gamrentals.com/es/").href;

/** Los idiomas que sirve el sitio oficial. */
const IDIOMAS: readonly [string, string][] = [
  ["es-ES", "https://gamrentals.com/es"],
  ["en", "https://gamrentals.com/en"],
  ["pt-PT", "https://gamrentals.com/pt"],
  ["es-MX", "https://gamrentals.com/mx"],
  ["es-CL", "https://gamrentals.com/cl"],
  ["es-PE", "https://gamrentals.com/pe"],
  ["fr-MA", "https://gamrentals.com/ma"],
  ["ar-SA", "https://gamrentals.com/sa"],
  ["x-default", "https://gamrentals.com/es"],
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

<!--
  Precargas primero. Sin esto, la imagen del héroe no empieza a bajar hasta que
  el navegador ha descargado y aplicado el CSS, porque hasta entonces no sabe
  qué tamaño le toca. Es lo que separa un LCP de 3 s de uno de 1,5 s.
-->
{
  precargas.map((recurso) => (
    <link
      rel="preload"
      as={recurso.como}
      href={recurso.href}
      media={recurso.media}
      imagesrcset={recurso.srcset}
      imagesizes={recurso.sizes}
      type={recurso.tipo}
      fetchpriority={recurso.prioritaria ? "high" : undefined}
      crossorigin={recurso.como === "font" ? "" : undefined}
    />
  ))
}

<title>{titulo}</title>
<meta name="description" content={descripcion} />
<meta
  name="robots"
  content={SITIO.indexable
    ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    : "noindex, nofollow"}
/>
<meta name="author" content="GAM · General de Alquiler de Maquinaria" />
<meta name="theme-color" content="#0B0E12" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
<meta name="format-detection" content="telephone=yes" />

<meta property="og:site_name" content="GAM Soluciones" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:type" content={tipo} />
<meta property="og:locale" content="es_ES" />
<meta property="og:url" content={canonica} />
<meta property="og:image" content={imagen} />
<meta
  property="og:image:alt"
  content="Delegación de GAM con plataformas elevadoras y carretillas listas para alquiler"
/>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />

<link rel="canonical" href={canonica} />
{IDIOMAS.map(([codigo, href]) => <link rel="alternate" hreflang={codigo} href={href} />)}

<link rel="icon" href={`${SITIO.base.replace(/\/$/, "")}/favicon.svg`} type="image/svg+xml" />

<!--
  No hay enlace a fonts.googleapis.com: las tipografias se sirven desde el
  mismo origen (ver src/estilos/base/fuentes.css). Pedirlas a Google obligaba
  a resolver dos dominios y abrir dos conexiones TLS antes de pintar la primera
  letra, y eso bloqueaba el renderizado 2,3 s en movil.
-->

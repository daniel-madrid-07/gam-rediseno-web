---
import Icono from "@componentes/base/Icono.astro";
import Plegable from "@componentes/base/Plegable.astro";
import {
  CONTRATOS,
  KITS_MEJORA,
  NIVELES_CONTRATO,
  REVISIONES,
} from "@datos/mantenimiento";
import { EMPRESA } from "@/config/sitio";

/**
 * Mantenimiento: los tres niveles de contrato y qué entra en cada revisión.
 *
 * La comparativa es una tabla de verdad, con `<th scope>` en filas y columnas.
 * Podría maquetarse con tarjetas y quedaría más «moderno», pero entonces quien
 * la recorra con lector de pantalla perdería la relación entre la celda y su
 * nivel de contrato, que es justamente la información que se viene a buscar.
 */
---

<section class="band band--alt cv" id="mantenimiento" aria-labelledby="h-mant">
  <div class="wrap">
    <div class="head head--split">
      <div>
        <span class="kicker">Mantenimiento</span>
        <h2 id="h-mant">Mantenimiento y reparación de maquinaria</h2>
        <p>
          Programas a medida para máquinas propias o para flotas de terceros. {EMPRESA.tecnicos}
          técnicos, {EMPRESA.talleresMoviles} talleres móviles, servicio de guardia y maquinaria de
          sustitución. Trabajamos con todas las marcas del mercado.
        </p>
      </div>
      <a class="btn btn--gam" href="#contacto">
        <Icono nombre="v-mantenimiento" />
        Solicitar soporte técnico
      </a>
    </div>

    <Plegable titulo="Los tres niveles de contrato">
      <div class="tablewrap">
        <table class="data">
          <caption>Los tres niveles de contrato</caption>
          <thead>
            <tr>
              <th scope="col">Qué cubre</th>
              {NIVELES_CONTRATO.map((nivel) => <th scope="col">{nivel}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              CONTRATOS.map((fila) => (
                <tr>
                  <th scope="row">{fila.concepto}</th>
                  {fila.niveles.map((celda) => (
                    <td
                      class={celda.tono}
                      colspan={"ancho" in celda ? celda.ancho : undefined}
                    >
                      {celda.texto}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </Plegable>

    <Plegable titulo="Qué incluye cada revisión">
      <div class="grid g3" style="margin-block-start:var(--s6)">
        {
          REVISIONES.map((bloque) => (
            <div class="panel">
              <div class="panel__ico">
                <Icono nombre={bloque.icono} />
              </div>
              <h3>{bloque.titulo}</h3>
              {bloque.apunte && <p class="t-xs t-muted">{bloque.apunte}</p>}
              <ul class="ticks" role="list">
                {bloque.puntos.map((punto) => (
                  <li>
                    <Icono nombre="i-check" /> {punto}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Plegable>

    <Plegable titulo="Kits de mejora">
      <div class="panel" style="margin-block-start:var(--s5)">
        <h3>Kits de mejora</h3>
        <p>No siempre hace falta cambiar la máquina; a veces basta con mejorarla.</p>
        <div class="chips" style="margin-block-start:var(--s2)">
          {KITS_MEJORA.map((kit) => <span class="chip chip--ghost">{kit}</span>)}
        </div>
      </div>
    </Plegable>
  </div>
</section>

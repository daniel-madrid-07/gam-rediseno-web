---
import Icono from "@componentes/base/Icono.astro";
import BuscadorDelegaciones from "@islas/Delegaciones.svelte";
import { EMPRESA } from "@/config/sitio";
import type { Delegacion } from "@tipos";

interface Props {
  delegaciones: Delegacion[];
}

const { delegaciones } = Astro.props;
---

<section class="band band--alt cv" id="delegaciones" aria-labelledby="h-del">
  <div class="wrap">
    <div class="head head--split">
      <div>
        <span class="kicker">Red comercial y técnica</span>
        <h2 id="h-del">Delegaciones en España</h2>
        <p>
          {delegaciones.length} delegaciones con taller y personal técnico. Busca por ciudad o provincia
          para ver dirección y teléfono directo.
        </p>
      </div>
      <a class="btn btn--ghost" href={`tel:${EMPRESA.telefonoE164}`}>
        <Icono nombre="i-phone" />
        {EMPRESA.telefono}
      </a>
    </div>

    <BuscadorDelegaciones {delegaciones} client:visible />
  </div>
</section>

---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Cabecera from "@componentes/layout/Cabecera.astro";
import Pie from "@componentes/layout/Pie.astro";
import BarraPulgar from "@componentes/layout/BarraPulgar.astro";
import Herramientas from "@componentes/layout/Herramientas.astro";
import Heroe from "@componentes/secciones/Heroe.astro";
import Familias from "@componentes/secciones/Familias.astro";
import Catalogo from "@componentes/secciones/Catalogo.astro";
import Cifras from "@componentes/secciones/Cifras.astro";
import Servicios from "@componentes/secciones/Servicios.astro";
import Mantenimiento from "@componentes/secciones/Mantenimiento.astro";
import Formacion from "@componentes/secciones/Formacion.astro";
import Delegaciones from "@componentes/secciones/Delegaciones.astro";
import SectoresMarcas from "@componentes/secciones/SectoresMarcas.astro";
import Sostenibilidad from "@componentes/secciones/Sostenibilidad.astro";
import Faq from "@componentes/secciones/Faq.astro";
import Contacto from "@componentes/secciones/Contacto.astro";
import { grafoDePortada } from "@lib/jsonld";
import { SITIO } from "@/config/sitio";
import type { Delegacion, Maquina, Servicio } from "@tipos";

/**
 * Portada.
 *
 * Lee las tres colecciones una vez y las reparte. El orden de las secciones es
 * el recorrido comercial: qué se alquila, cómo se encuentra, quién lo respalda,
 * qué más se ofrece y por dónde se contacta.
 */
const catalogo = (await getCollection("catalogo")).map((e) => e.data as Maquina);
const servicios = (await getCollection("servicios")).map((e) => e.data as Servicio);
const delegaciones = (await getCollection("delegaciones")).map((e) => e.data as Delegacion);

const datosEstructurados = grafoDePortada({ catalogo, servicios, delegaciones });

const base = SITIO.base.replace(/\/$/, "");

/**
 * La foto del héroe es el LCP. Se precarga con la misma condición `media` que
 * usa el <picture>, para que el navegador baje exactamente el mismo archivo
 * que va a pintar y no dos.
 */
const precargas = [
  {
    href: `${base}/img/hero-mov.avif`,
    como: "image" as const,
    media: "(max-width: 47.99rem)",
    tipo: "image/avif",
    prioritaria: true,
  },
  {
    href: `${base}/img/hero-xl.webp`,
    como: "image" as const,
    media: "(min-width: 48rem)",
    srcset: `${base}/img/hero-m.webp 800w, ${base}/img/hero-xl.webp 1600w`,
    sizes: "(min-width: 62rem) 46vw, 100vw",
    prioritaria: true,
  },
];
---

<Base titulo={SITIO.titulo} descripcion={SITIO.descripcion} {precargas}>
  <script
    slot="cabeza"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(datosEstructurados)}
  />

  <Cabecera {servicios} />

  <main id="contenido">
    <Heroe />
    <Familias {catalogo} />
    <Catalogo {catalogo} />
    <Cifras />
    <Servicios {servicios} />
    <Mantenimiento />
    <Formacion />
    <Delegaciones {delegaciones} />
    <SectoresMarcas />
    <Sostenibilidad />
    <Faq />
    <Contacto {catalogo} {delegaciones} />
  </main>

  <Pie />
  <BarraPulgar />
  <Herramientas {catalogo} {servicios} />
</Base>

<script>
  import { iniciarAtajos } from "@lib/atajos";
  import { iniciarPlegables } from "@lib/plegables";

  iniciarAtajos();
  iniciarPlegables();
</script>
